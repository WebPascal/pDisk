include('/conn.cfg');
include('/verify_token.api');

try
  var title := URLEncode.Decode(request.Params['title'], false);
  var password := URLEncode.Decode(request.Params['password'], false);
  var filesJson := URLEncode.Decode(request.Params['files'], false);

  if (title = '') or (password = '') or (filesJson = '') then
  begin
    writeln('{"code":400,"msg":"api.paramIncomplete"}');
    exit;
  end;

  var username := ReadGlobalVar('_username');
  var isAdmin := StrToInt(ReadGlobalVar('_isAdmin'));

  // 查询昵称
  var userRes := json.parse(db.query('mydb', 'SELECT FNickname FROM tUsers WHERE FUsername=:p1', username));
  var nickname := username;
  if (userRes.code = 200) and (userRes.data.length() > 0) then
    nickname := userRes.data[0].FNickname;

  // 生成雪花ID（WebPascal Snowflake 直接返回字符串）
  var shareId := Snowflake(0, 0);

  var nowStr := FormatDateTime('yyyy-MM-dd hh:nn:ss', Now);
  db.exec('mydb', 'INSERT INTO tShares(FShareID, FTitle, FPassword, FUsername, FNickname, FFiles, FCreateTime) VALUES(:p1, :p2, :p3, :p4, :p5, :p6, :p7)',
    shareId, title, password, username, nickname, filesJson, nowStr);

  var ret := json.NewObject;
  ret.code := 200;
  ret.msg := 'share.createSuccess';
  ret.shareId := shareId;
  writeln(json.stringify(ret));
except on E : Exception do
begin
  writeln('{"code":500,"msg":"' + E.Message + '"}');
end;
end;
